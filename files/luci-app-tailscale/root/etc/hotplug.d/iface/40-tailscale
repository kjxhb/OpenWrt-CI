#!/bin/sh

tailscale_enable="$(uci -q get tailscale.settings.enabled 2>/dev/null)"
# default to 0 if unset
tailscale_enable="${tailscale_enable:-0}"

[ "$ACTION" = "ifup" -o "$ACTION" = "ifupdate" ] || exit 0
[ "$ACTION" = "ifupdate" -a -z "$IFUPDATE_ADDRESSES" -a -z "$IFUPDATE_DATA" ] && exit 0
[ "$tailscale_enable" = "1" ] || exit 0
/etc/init.d/tailscale start > /tmp/tailscale.log 2>&1 &
