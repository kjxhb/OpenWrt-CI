#!/bin/sh

# Copyright (C) 2025 asvow
# SPDX-License-Identifier: GPL-3.0-only

# Minimal, safer /usr/sbin/tailscale_helper that delegates to
# /usr/libexec/luci-tailscale-helper when available and otherwise
# implements a portable fallback. The original script had non-portable
# constructs and was incomplete; this version keeps behavior predictable.

set -eu

REVERT_EXIT() {
    logger -p daemon.err -t tailscale_helper "$1"
    uci -q revert dhcp || true
    uci -q revert network || true
    uci -q revert firewall || true
    [ -x /etc/init.d/tailscale ] && /etc/init.d/tailscale stop || true
    exit 1
}

# Prefer the packaged luci helper if present
HELPER="/usr/libexec/luci-tailscale-helper"
if [ -x "$HELPER" ]; then
    exec "$HELPER" "$@"
fi

TAILSCALE_BIN="/usr/sbin/tailscale"
if [ ! -x "$TAILSCALE_BIN" ]; then
    REVERT_EXIT "tailscale binary not found at $TAILSCALE_BIN"
fi

# Run tailscale up with passed args
if ! "$TAILSCALE_BIN" up --reset "$@"; then
    REVERT_EXIT "tailscale up failed"
fi

# Acquire a simple lock using mkdir (portable)
LOCKDIR="/var/lock/tailscale.lock"
LOCK_CREATED=0
if mkdir "$LOCKDIR" 2>/dev/null; then
    LOCK_CREATED=1
    trap 'rmdir "$LOCKDIR" >/dev/null 2>&1; exit' INT TERM EXIT
fi

# wait for IPv4 address (timeout ~30s)
COUNT=0
FOUND=0
while [ "$COUNT" -lt 15 ]; do
    if "$TAILSCALE_BIN" ip -4 >/dev/null 2>&1; then
        FOUND=1
        break
    fi
    sleep 2
    COUNT=$((COUNT + 1))
done

if [ "$FOUND" -ne 1 ]; then
    [ "$LOCK_CREATED" -eq 1 ] && rmdir "$LOCKDIR" >/dev/null 2>&1 || true
    REVERT_EXIT "timed out waiting for Tailscale IPv4 address"
fi

# cleanup lock if we created it
[ "$LOCK_CREATED" -eq 1 ] && rmdir "$LOCKDIR" >/dev/null 2>&1 || true

exit 0
