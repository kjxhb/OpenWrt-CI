#!/bin/sh
# luci-tailscale helper (portable / POSIX compatible)
# This helper is intentionally minimal: it invokes `tailscale up` with provided arguments,
# waits for an IPv4 address to appear, and exits. It avoids modifying /etc/config or init scripts
# so it does not conflict with the upstream openwrt/package/tailscale package.

set -eu

REVERT_EXIT() {
    logger -p daemon.err -t luci-tailscale "$1"
    # do not attempt to revert system config here to avoid clobbering upstream package state
    exit 1
}

TAILSCALE_BIN="/usr/sbin/tailscale"
LOCKDIR="/var/lock/luci-tailscale.lock"

if [ ! -x "$TAILSCALE_BIN" ]; then
    REVERT_EXIT "tailscale binary not found at $TAILSCALE_BIN"
fi

# Run tailscale up with passed args
if ! "$TAILSCALE_BIN" up --reset "$@"; then
    REVERT_EXIT "tailscale up failed"
fi

# Acquire a simple lock using mkdir (portable)
LOCK_CREATED=0
if mkdir "$LOCKDIR" 2>/dev/null; then
    LOCK_CREATED=1
    trap 'rmdir "$LOCKDIR" >/dev/null 2>&1; exit' INT TERM EXIT
fi

# wait for IPv4 address (timeout ~30s)
COUNT=0
FOUND=0
while [ "$COUNT" -lt 15 ]; do
    if $TAILSCALE_BIN ip -4 >/dev/null 2>&1; then
        FOUND=1
        break
    fi
    sleep 2
    COUNT=$((COUNT + 1))
done

if [ "$FOUND" -ne 1 ]; then
    [ "$LOCK_CREATED" -eq 1 ] && rmdir "$LOCKDIR" >/dev/null 2>&1 || true
    REVERT_EXIT "timed out waiting for Tailscale IPv4 address"
fi

# cleanup lock if we created it
if [ "$LOCK_CREATED" -eq 1 ]; then
    rmdir "$LOCKDIR" >/dev/null 2>&1 || true
fi

exit 0
