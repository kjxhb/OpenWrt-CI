#!/bin/sh
# helper wrapper used by hotplug to start system tailscale init if present
# This small wrapper ensures we call the system init which may be provided by openwrt/package/tailscale

if [ -x "/etc/init.d/tailscale" ]; then
    /etc/init.d/tailscale start
else
    logger -p daemon.err -t luci-tailscale "/etc/init.d/tailscale not present; install tailscale package"
fi
